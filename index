    for(const run of clipRing2(c)){
      if(run.length<3) continue;
      tracePath(run); ctx.fillStyle=c.fill; ctx.fill();
    }
  }
  // state borders (inside land)
  if(showStates && zoom>0.95){
    for(const r of STATES) strokeVisible(r,'rgba(150,133,104,.55)',0.6,[3,3]);
  }
  // country borders
  for(const c of CO){
    for(const ring of c.r) strokeVisible(ring,'rgba(126,108,80,.85)',0.85);
  }
  // lakes
  for(const r of LAKES){
    for(const run of clipRing(r)){ if(run.length<3)continue; tracePath(run); ctx.fillStyle='#9CC0D4'; ctx.fill(); }
  }
  // limb shading
  const lg=ctx.createRadialGradient(cx,cy,R*0.70,cx,cy,R);
  lg.addColorStop(0,'rgba(60,50,30,0)'); lg.addColorStop(1,'rgba(58,48,28,.30)');
  ctx.beginPath(); ctx.arc(cx,cy,R,0,7); ctx.fillStyle=lg; ctx.fill();
  // sun sheen
  const sh=ctx.createRadialGradient(cx-R*0.42,cy-R*0.46,0,cx-R*0.42,cy-R*0.46,R*0.95);
  sh.addColorStop(0,'rgba(255,252,238,.30)'); sh.addColorStop(1,'rgba(255,252,238,0)');
  ctx.beginPath(); ctx.arc(cx,cy,R,0,7); ctx.fillStyle=sh; ctx.fill();
  ctx.restore();

  ctx.beginPath(); ctx.arc(cx,cy,R,0,7);
  ctx.strokeStyle='rgba(110,95,70,.55)'; ctx.lineWidth=1.1; ctx.stroke();
}
function clipRing2(c){
  let out=[];
  for(const ring of c.r) out=out.concat(clipRing(ring));
  return out;
}
function gRing(val,isLat){
  ctx.beginPath(); let pen=false;
  for(let t=0;t<=360;t+=3){
    const r=rot(isLat?vec(t-180,val):vec(val,(t/2)-90));
    if(r[2]>0){const s=scr(r); pen?ctx.lineTo(s[0],s[1]):(ctx.moveTo(s[0],s[1]),pen=true);}
    else pen=false;
  }
  ctx.stroke();
}

/* ---------- the moon ---------- */
function stepMoon(dt){ moonA=(moonA+dt*1.05e-4)%(Math.PI*2); }
function computeMoon(){
  // fades away as you zoom in, so it never crowds the map
  const a = showMoon ? Math.max(0,Math.min(1,(1.30-zoom)/0.22)) : 0;
  if(a<=0.01){ moon=null; return; }
  const Rorb=Math.min(R*1.55, Math.min(W,H)*0.46);
  const ox=Math.cos(moonA)*Rorb, oz=Math.sin(moonA)*Rorb;
  const ct=Math.cos(MOON_TILT), st=Math.sin(MOON_TILT);
  moon={x:cx+ox, y:cy+oz*st, depth:oz*ct, r:Math.max(6,R*0.085), a};
}
function drawMoon(){
  if(!moon) return;
  const {x,y,r,a}=moon;
  ctx.save(); ctx.globalAlpha=a;
  const g=ctx.createRadialGradient(x,y,r*0.55,x,y,r*2.4);
  g.addColorStop(0,'rgba(255,250,230,.30)'); g.addColorStop(1,'rgba(255,250,230,0)');
  ctx.beginPath(); ctx.arc(x,y,r*2.4,0,7); ctx.fillStyle=g; ctx.fill();
  const b=ctx.createRadialGradient(x-r*0.36,y-r*0.40,r*0.08,x,y,r*1.08);
  b.addColorStop(0,'#FCF7EA'); b.addColorStop(.58,'#E9E0CC'); b.addColorStop(1,'#C0B49C');
  ctx.beginPath(); ctx.arc(x,y,r,0,7); ctx.fillStyle=b; ctx.fill();
  ctx.save();
  ctx.beginPath(); ctx.arc(x,y,r,0,7); ctx.clip();
  const CR=[[-.30,-.16,.21],[.24,-.32,.13],[.06,.30,.23],[-.44,.28,.12],[.42,.14,.10],[-.08,-.48,.09],[.30,.46,.11]];
  ctx.fillStyle='rgba(148,135,111,.42)';
  for(const [dx,dy,rr] of CR){ ctx.beginPath(); ctx.arc(x+dx*r,y+dy*r,rr*r,0,7); ctx.fill(); }
  ctx.restore();
  ctx.beginPath(); ctx.arc(x,y,r,0,7);
  ctx.strokeStyle='rgba(138,122,94,.42)'; ctx.lineWidth=0.8; ctx.stroke();
  ctx.restore();
}

/* ---------- compass ring ---------- */
function drawCompass(){
  const rr=R*1.055;
  ctx.save();
  ctx.strokeStyle='rgba(140,120,90,.40)'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.arc(cx,cy,rr,0,7); ctx.stroke();
  for(let a=0;a<360;a+=10){
    const t=(a-90)*DEG, major=a%90===0, len=major?9:(a%30===0?6:3.5);
    ctx.beginPath();
    ctx.moveTo(cx+Math.cos(t)*rr, cy+Math.sin(t)*rr);
    ctx.lineTo(cx+Math.cos(t)*(rr+len), cy+Math.sin(t)*(rr+len));
    ctx.strokeStyle=major?'rgba(120,100,72,.75)':'rgba(150,132,102,.45)';
    ctx.lineWidth=major?1.4:0.8; ctx.stroke();
  }
  const lbl=[['N',0],['E',90],['S',180],['W',270]];
  ctx.font='600 13px '+FS; ctx.textAlign='center'; ctx.textBaseline='middle';
  for(const [t,a] of lbl){
    const th=(a-90)*DEG, d=rr+24;
    const x=cx+Math.cos(th)*d, y=cy+Math.sin(th)*d;
    ctx.fillStyle='#FBF7EE'; ctx.beginPath(); ctx.arc(x,y,11,0,7); ctx.fill();
    ctx.strokeStyle='rgba(140,120,90,.45)'; ctx.lineWidth=1; ctx.stroke();
    ctx.fillStyle=t==='N'?'#8A3A2E':'#6E6455'; ctx.fillText(t,x,y+0.5);
  }
  ctx.restore();
}

/* ---------- country labels ---------- */
const FS='"Fraunces",Georgia,serif';
let labelBoxes=[];
function fits(x,y,w,h){
  for(const b of labelBoxes) if(Math.abs(x-b.x)<(w+b.w)/2+4 && Math.abs(y-b.y)<(h+b.h)/2+3) return false;
  labelBoxes.push({x,y,w,h}); return true;
}
function drawCountryLabels(){
  if(!showCountries) return;
  const minA = 40/Math.max(zoom,0.8);
  ctx.textAlign='center'; ctx.textBaseline='middle';
  for(const c of CO){
    if(c.a<minA) continue;
    const r=rot(c.c);
    if(r[2]<0.26) continue;
    const s=scr(r);
    const fs=Math.max(8.5,Math.min(13,7.5+Math.sqrt(c.a)*0.11))*Math.min(1.25,Math.max(0.9,zoom*0.95));
    ctx.font='500 '+fs.toFixed(1)+'px '+FS;
    const t=c.n.toUpperCase(), w=ctx.measureText(t).width;
    if(w>R*1.05) continue;
    if(!fits(s[0],s[1],w,fs+2)) continue;
    ctx.lineWidth=2.6; ctx.strokeStyle='rgba(252,248,238,.82)';
    ctx.strokeText(t,s[0],s[1]); ctx.fillStyle='rgba(90,76,54,.80)'; ctx.fillText(t,s[0],s[1]);
  }
}

/* ================= arcs ================= */
function drawArc(v1,v2,color,w,dash,alpha){
  const dot=Math.max(-1,Math.min(1,v1[0]*v2[0]+v1[1]*v2[1]+v1[2]*v2[2]));
  const om=Math.acos(dot), so=Math.sin(om), lift=0.09+0.20*(om/Math.PI);
  ctx.save(); ctx.strokeStyle=color; ctx.lineWidth=w; ctx.globalAlpha=alpha;
  ctx.lineCap='round'; if(dash)ctx.setLineDash(dash);
  ctx.beginPath(); let pen=false;
  for(let i=0;i<=56;i++){
    const t=i/56; let p;
    if(so<1e-6) p=v1;
    else{const A=Math.sin((1-t)*om)/so,B=Math.sin(t*om)/so;
      p=nrm([v1[0]*A+v2[0]*B, v1[1]*A+v2[1]*B, v1[2]*A+v2[2]*B]);}
    const rad=1+lift*Math.sin(Math.PI*t), r=rot(p);
    if(r[2]<=0 && Math.hypot(r[0]*rad,r[1]*rad)<1){pen=false;continue;}
    const s=scr(r,rad); pen?ctx.lineTo(s[0],s[1]):(ctx.moveTo(s[0],s[1]),pen=true);
  }
  ctx.stroke(); ctx.restore();
}

/* ================= ancestry ================= */
const TRAIN=new Set(['phd','postdoc','trained','cluster']);
let chainEdges=new Set(), chainNodes=new Set();
function ancestryChains(id){
  const out=[];
  (function walk(cur,path,d){
    if(d>7||out.length>30) return;
    const ups=IN[cur].filter(e=>TRAIN.has(e.k));
    if(!ups.length){ if(path.length>1) out.push(path.slice()); return; }
    for(const e of ups){
      if(path.indexOf(e.a)!==-1) continue;
      path.unshift(e.a); walk(e.a,path,d+1); path.shift();
    }
  })(id,[id],0);
  out.sort((a,b)=>b.length-a.length);
  return out.slice(0,4);
}
function buildChain(id){
  chainEdges=new Set(); chainNodes=new Set();
  if(!id) return [];
  const ch=ancestryChains(id);
  ch.forEach(c=>c.forEach((n,i)=>{chainNodes.add(n); if(i)chainEdges.add(c[i-1]+'>'+n);}));
  return ch;
}

/* ========= markers: Earth-anchored clustering + gentle de-overlap ========= */
function pVis(p){
  if(!fCty.has(D.sites[p.site].country)) return false;
  if(p.area==='industry') return fArea.has('industry');
  if(p.tier==='mentor')   return fArea.has('mentor');
  return fArea.has(p.area);
}
let fver=0;
function bumpFilters(){ fver++; }

// Clusters are keyed to a grid fixed to the EARTH, not the screen, so turning the
// globe can never reshuffle them. They only re-form when you zoom.
let clusters=[], clusterKey='';
function buildClusters(){
  const T=Math.max(0.30,Math.min(3.0,2.6/Math.pow(zoom,1.15)));
  const ck=T.toFixed(3)+'|'+fver;
  if(ck===clusterKey) return;
  clusterKey=ck;
  const cells={};
  for(const sid in D.sites){
    const list=SITEP[sid].filter(id=>pVis(P[id]));
    if(!list.length) continue;
    const s=D.sites[sid];
    const wLon=T/Math.max(0.22,Math.cos(s.lat*DEG));
    const k=Math.floor(s.lat/T)+':'+Math.floor(s.lon/wLon);
    (cells[k]=cells[k]||[]).push({sid,s,list});
  }
  clusters=[];
  for(const k in cells){
    const ms=cells[k].sort((a,b)=> b.list.length-a.list.length || (a.sid<b.sid?-1:1));
    let x=0,y=0,z=0,people=[];
    ms.forEach(m=>{const v=vec(m.s.lon,m.s.lat); x+=v[0];y+=v[1];z+=v[2]; people=people.concat(m.list);});
    const tally={};
    people.forEach(id=>{const a=P[id].area; tally[a]=(tally[a]||0)+1;});
    let dom=P[people[0]].area,best=-1;
    for(const a in tally) if(tally[a]>best||(tally[a]===best&&a<dom)){best=tally[a];dom=a;}
    clusters.push({key:k, sites:ms, v:nrm([x,y,z]), people, dom,
      multi:Object.keys(tally).length>1,
      label: ms[0].s.short+(ms.length>1?'  +'+(ms.length-1):'')});
  }
  clusters.sort((a,b)=> a.key<b.key?-1:1);
}
function radiusOf(n){
  const base=Math.min(12.5, 5.0+Math.sqrt(Math.max(0,n.c.people.length-1))*2.3);
  return base*Math.min(1.45,Math.max(0.88,zoom));
}
const smooth={};
let nodes=[];
function layout(){
  buildClusters();
  const raw=clusters.map(c=>{const r=rot(c.v), sp=scr(r);
    return {c,key:c.key,z:r[2],tx:sp[0],ty:sp[1],sx:sp[0],sy:sp[1]};});
  for(const n of raw) n.r=radiusOf(n);
  const front=raw.filter(n=>n.z>-0.08);
  for(const n of front) n.w=Math.max(0,Math.min(1,(n.z+0.08)/0.26));
  const GAP=4.5;
  // Jacobi (simultaneous) updates: order-independent, so the result is a smooth
  // function of rotation and markers never flip past one another.
  for(let it=0;it<60;it++){
    for(const n of front){ n.dx=0; n.dy=0; }
    for(let i=0;i<front.length;i++){
      for(let j=i+1;j<front.length;j++){
        const a=front[i],b=front[j], wgt=Math.min(a.w,b.w);
        if(wgt<=0.001) continue;
        const need=a.r+b.r+GAP;
        let dx=b.sx-a.sx, dy=b.sy-a.sy, d=Math.hypot(dx,dy);
        if(d>need) continue;
        if(d<1e-4){const th=i*2.399963; dx=Math.cos(th);dy=Math.sin(th);d=1;}
        const push=(need-d)/2*wgt; dx/=d; dy/=d;
        a.dx-=dx*push; a.dy-=dy*push; b.dx+=dx*push; b.dy+=dy*push;
      }
    }
    for(const n of front){
      n.sx+=n.dx*0.62; n.sy+=n.dy*0.62;
      const k=0.045+0.14*(1-n.w);
      n.sx+=(n.tx-n.sx)*k; n.sy+=(n.ty-n.sy)*k;
    }
  }
  for(const n of raw){
    const prev=smooth[n.key];
    if(prev && Math.hypot(prev.x-n.sx,prev.y-n.sy)<90){
      n.sx=prev.x+(n.sx-prev.x)*0.30; n.sy=prev.y+(n.sy-prev.y)*0.30;
    }
    smooth[n.key]={x:n.sx,y:n.sy};
  }
  raw.sort((a,b)=>a.z-b.z);
  nodes=raw;
}

function drawEdges(){
  const list = showNet ? D.edges
    : (selPerson ? D.edges.filter(e=>e.a===selPerson||e.b===selPerson) : []);
  if(selPerson && chainEdges.size){
    for(const e of D.edges){
      if(!chainEdges.has(e.a+'>'+e.b)) continue;
      if(e.a===selPerson||e.b===selPerson) continue;
      const A=P[e.a],B=P[e.b]; if(!pVis(A)||!pVis(B)) continue;
      drawArc(vec(D.sites[A.site].lon,D.sites[A.site].lat),
              vec(D.sites[B.site].lon,D.sites[B.site].lat),'#7A6A55',1.5,[1,5],0.62);
    }
  }
  for(const e of list){
    const A=P[e.a],B=P[e.b]; if(!pVis(A)||!pVis(B)) continue;
    if(A.site===B.site) continue;
    const k=D.kinds[e.k], hot=selPerson&&(e.a===selPerson||e.b===selPerson);
    drawArc(vec(D.sites[A.site].lon,D.sites[A.site].lat),
            vec(D.sites[B.site].lon,D.sites[B.site].lat),
            k.color, hot?k.w*1.2:k.w*0.75, k.dash, hot?0.9:(showNet?0.26:0.6));
  }
}

function nodeHot(n){
  if(selCluster===n.key) return 2;
  if(selSite && n.c.sites.some(m=>m.sid===selSite)) return 2;
  if(selPerson){
    if(n.c.people.indexOf(selPerson)!==-1) return 2;
    for(const id of n.c.people){ if(NEIGH[selPerson].has(id)) return 1; }
    for(const id of n.c.people){ if(chainNodes.has(id)) return 1; }
  }
  return 0;
}
function drawNodes(){
  const dim=!!(selPerson||selSite||selCluster);
  for(const n of nodes){
    const hot=nodeHot(n);
    let a=Math.min(1,Math.max(0,(n.z-0.14)/0.12));
    if(dim && !hot) a*=0.30;
    if(a<0.02) continue;
    const col=D.areas[n.c.dom].color, cnt=n.c.people.length;
    let r=n.r||radiusOf(n);
    if(hot===2) r*=1.32; else if(hot===1) r*=1.12;
    if(hoverKey===n.key) r*=1.16;

    const off=Math.hypot(n.sx-n.tx,n.sy-n.ty);
    if(off>3.5){
      ctx.globalAlpha=a*0.5; ctx.strokeStyle='rgba(70,58,40,.55)'; ctx.lineWidth=0.8;
      ctx.beginPath(); ctx.moveTo(n.tx,n.ty); ctx.lineTo(n.sx,n.sy); ctx.stroke();
      ctx.beginPath(); ctx.arc(n.tx,n.ty,1.4,0,7); ctx.fillStyle='rgba(70,58,40,.6)'; ctx.fill();
    }
    ctx.globalAlpha=a;
    if(hot){ ctx.beginPath(); ctx.arc(n.sx,n.sy,r*2.5,0,7);
      ctx.fillStyle=col; ctx.globalAlpha=a*(hot===2?0.20:0.12); ctx.fill(); ctx.globalAlpha=a; }
    ctx.beginPath(); ctx.arc(n.sx+0.8,n.sy+1.5,r,0,7); ctx.fillStyle='rgba(70,55,30,.20)'; ctx.fill();
    ctx.beginPath(); ctx.arc(n.sx,n.sy,r,0,7); ctx.fillStyle=col; ctx.fill();
    ctx.lineWidth=hot===2?2.2:1.5;
    ctx.strokeStyle=hot===2?'#3A342B':'rgba(252,248,238,.92)'; ctx.stroke();
    if(n.c.sites.length>1 && r>7.5){
      ctx.beginPath(); ctx.arc(n.sx,n.sy,r+3.1,0,7);
      ctx.strokeStyle=col; ctx.globalAlpha=a*0.5; ctx.lineWidth=1.1; ctx.stroke(); ctx.globalAlpha=a;
    }
    if(n.c.multi && r>7){ ctx.beginPath(); ctx.arc(n.sx,n.sy,r*0.44,0,7);
      ctx.fillStyle='rgba(252,248,238,.80)'; ctx.fill(); }
    if(cnt>1 && r>=9){
      ctx.font='600 '+Math.round(Math.min(12.5,r*0.92))+'px '+FS;
      ctx.textAlign='center'; ctx.textBaseline='middle';
      ctx.fillStyle=n.c.multi?'#4A4238':'rgba(252,248,238,.96)';
      ctx.fillText(String(cnt),n.sx,n.sy+0.5);
    }
    ctx.globalAlpha=1;
  }
  ctx.textAlign='left'; ctx.textBaseline='middle';
  for(const n of nodes.slice().sort((a,b)=>b.z-a.z)){
    if(n.z<=0.30) continue;
    const hot=nodeHot(n);
    if(!hot && !showNames && hoverKey!==n.key) continue;
    const t=n.c.label, fs=hot?12.5:11.5;
    ctx.font=(hot?'600 ':'500 ')+fs+'px '+FS;
    const w=ctx.measureText(t).width, r=n.r||radiusOf(n);
    let lx=n.sx+r+6, ly=n.sy;
    if(lx+w>W-14) lx=n.sx-r-6-w;
    if(!fits(lx+w/2,ly,w+8,fs+4) && !hot) continue;
    ctx.globalAlpha=hot?1:0.94;
    ctx.lineWidth=3; ctx.strokeStyle='rgba(252,248,238,.88)'; ctx.strokeText(t,lx,ly);
    ctx.fillStyle=hot===2?'#2B2620':'#4A4238'; ctx.fillText(t,lx,ly);
    ctx.globalAlpha=1;
  }
}

/* ================= loop ================= */
let last=performance.now();
function frame(now){
  const dt=Math.min(64,now-last); last=now;
  if(spin && !dragging && !flying) lon0=(lon0+dt*0.0026)%360;
  if(flying) stepFly(dt);
  stepMoon(dt);
  setRot(); tick();
  ctx.clearRect(0,0,W,H);
  labelBoxes=[];
  computeMoon();
  if(moon && moon.depth<0) drawMoon();   // behind the Earth, so the globe hides it
  drawGlobe();
  drawCountryLabels();
  layout();
  drawEdges();
  drawNodes();
  drawCompass();
  if(moon && moon.depth>=0) drawMoon();  // in front, so it passes over the globe
  requestAnimationFrame(frame);
}
function tick(){
  if(cv.clientWidth!==lastW||cv.clientHeight!==lastH){lastW=cv.clientWidth;lastH=cv.clientHeight;resize();}
  else R=Math.min(W,H)*(W<960?0.38:0.352)*zoom;
}

/* ================= fly-to ================= */
let flying=null;
function flyTo(lon,lat){
  let d=((lon-lon0+540)%360)-180;
  flying={t:0,l0:lon0,p0:lat0,dl:d,dp:lat-lat0};
}
function stepFly(dt){
  flying.t=Math.min(1,flying.t+dt/700);
  const e=flying.t<.5?2*flying.t*flying.t:1-Math.pow(-2*flying.t+2,2)/2;
  lon0=flying.l0+flying.dl*e; lat0=flying.p0+flying.dp*e;
  if(flying.t>=1) flying=null;
}

/* ================= interaction ================= */
let dragging=false, moved=0, px=0, py=0;
cv.addEventListener('pointerdown',e=>{dragging=true;moved=0;px=e.clientX;py=e.clientY;
  cv.classList.add('drag');cv.setPointerCapture(e.pointerId);});
cv.addEventListener('pointermove',e=>{
  if(dragging){
    const dx=e.clientX-px, dy=e.clientY-py; px=e.clientX;py=e.clientY;
    moved+=Math.abs(dx)+Math.abs(dy);
    lon0-=dx*0.27/zoom; lat0=Math.max(-85,Math.min(85,lat0+dy*0.27/zoom)); flying=null;
  } else hit(e.clientX,e.clientY,true);
});
cv.addEventListener('pointerup',e=>{cv.classList.remove('drag');
  if(dragging&&moved<6) hit(e.clientX,e.clientY,false); dragging=false;});
cv.addEventListener('pointerleave',()=>{hoverSite=null;tip.classList.remove('on');});
cv.addEventListener('wheel',e=>{e.preventDefault();
  zoom=Math.max(0.72,Math.min(3.6,zoom*(e.deltaY<0?1.09:1/1.09)));},{passive:false});

const tip=document.getElementById('tip');
function hit(mx,my,hover){
  const b=cv.getBoundingClientRect(), x=mx-b.left, y=my-b.top;
  let best=null,bd=1e9;
  for(const n of nodes){
    if(n.z<=0.15) continue;
    const d=Math.hypot(n.sx-x,n.sy-y);
    if(d<Math.max(14,(n.r||radiusOf(n))+6) && d<bd){bd=d;best=n;}
  }
  if(hover){
    hoverKey=best?best.key:null;
    if(best){
      const c=best.c, one=c.sites.length===1;
      const rows=one? c.people.slice(0,5).map(id=>esc(P[id].name))
                    : c.sites.slice(0,5).map(m=>esc(m.s.short)+' <span style="color:#9C907C">'+m.list.length+'</span>');
      const total=one?c.people.length:c.sites.length;
      const more=total-rows.length;
      const head=one?c.sites[0].s.label:c.sites.length+' institutions nearby';
      const sub=one?(c.sites[0].s.city+', '+c.sites[0].s.country)
                   :(c.people.length+' people and companies');
      tip.innerHTML=`<b>${esc(head)}</b><div class="t2">${esc(sub)}</div>`+
        `<ul>${rows.map(r=>'<li>'+r+'</li>').join('')}${more>0?'<li style="color:#9C907C">+ '+more+' more</li>':''}</ul>`+
        (one?'':'<div class="t2" style="margin-top:6px">zoom in to separate them</div>');
      tip.style.left=Math.min(mx+16,window.innerWidth-286)+'px';
      tip.style.top=Math.min(my+16,window.innerHeight-210)+'px';
      tip.classList.add('on'); cv.style.cursor='pointer';
    } else {tip.classList.remove('on'); cv.style.cursor='grab';}
  } else {
    if(!best){ closePanel(); return; }
    const c=best.c;
    if(c.sites.length===1 && c.people.length===1) selectPerson(c.people[0]);
    else if(c.sites.length===1) selectSite(c.sites[0].sid);
    else selectCluster(best.key);
  }
}
function esc(s){return String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}

/* ================= panel ================= */
const info=document.getElementById('info'), ibody=document.getElementById('i-body');
const backBtn=document.getElementById('back');
function closePanel(){selSite=null;selPerson=null;selCluster=null;chainEdges=new Set();chainNodes=new Set();info.classList.remove('on');}
document.getElementById('close').onclick=closePanel;
backBtn.onclick=()=>{ if(selPerson) selectSite(P[selPerson].site); };

function selectSite(sid){
  selSite=sid; selPerson=null; selCluster=null; chainEdges=new Set(); chainNodes=new Set();
  const s=D.sites[sid], list=SITEP[sid].filter(id=>pVis(P[id]));
  document.getElementById('i-eyebrow').textContent='Institution';
  document.getElementById('i-name').textContent=s.label;
  document.getElementById('i-inst').textContent=list.length+(list.length===1?' person or company':' people and companies on the map here');
  document.getElementById('i-loc').textContent=s.city+', '+s.country;
  backBtn.style.display='none';
  const byArea={};
  list.forEach(id=>{const a=P[id].area;(byArea[a]=byArea[a]||[]).push(id);});
  let html='';
  for(const a of Object.keys(D.areas)){
    if(!byArea[a]) continue;
    const col=D.areas[a].color;
    html+=`<div class="lk"><div class="h" style="color:${col}"><i style="border-color:${col}"></i>${esc(D.areas[a].label)}</div><ul>`;
    byArea[a].forEach(id=>{
      const p=P[id], n=(NEIGH[id]||new Set()).size;
      html+=`<li data-go="${id}"><span class="dot" style="background:${col}"></span>`+
            `<span><span style="color:#4A4238">${esc(p.name)}</span>`+
            `<span class="sub2">${esc(D.tiers[p.tier].label)}</span></span>`+
            `<span class="w">${n?n+' link'+(n>1?'s':''):'—'}</span></li>`;
    });
    html+='</ul></div>';
  }
  ibody.innerHTML=html; wire(); info.classList.add('on');
  document.getElementById('hint').style.opacity=0;
}

function selectCluster(key){
  const c=clusters.find(x=>x.key===key); if(!c) return;
  selCluster=key; selSite=null; selPerson=null; chainEdges=new Set(); chainNodes=new Set();
  document.getElementById('i-eyebrow').textContent=c.sites.length+' institutions close together';
  document.getElementById('i-name').textContent=c.sites[0].s.city+' area';
  document.getElementById('i-inst').textContent=c.people.length+' people and companies across '+c.sites.length+' institutions';
  document.getElementById('i-loc').textContent=[...new Set(c.sites.map(m=>m.s.country))].join(' · ');
  backBtn.style.display='none';
  let html='';
  c.sites.forEach(m=>{
    const col=D.areas[P[m.list[0]].area].color;
    html+=`<div class="lk"><div class="h" style="color:${col}"><i style="border-color:${col}"></i>`+
          `${esc(m.s.short)} \u00b7 ${esc(m.s.city)}</div><ul>`;
    m.list.forEach(id=>{const p=P[id], n=(NEIGH[id]||new Set()).size;
      html+=`<li data-go="${id}"><span class="dot" style="background:${D.areas[p.area].color}"></span>`+
            `<span><span style="color:#4A4238">${esc(p.name)}</span>`+
            `<span class="sub2">${esc(D.tiers[p.tier].label)}</span></span>`+
            `<span class="w">${n?n+' link'+(n>1?'s':''):'\u2014'}</span></li>`;});
    html+='</ul></div>';
  });
  ibody.innerHTML=html; wire(); info.classList.add('on');
  document.getElementById('hint').style.opacity=0;
}
function selectPerson(id){
  selPerson=id; selSite=P[id].site; selCluster=null;
  const p=P[id], s=D.sites[p.site], ar=D.areas[p.area];
  document.getElementById('i-eyebrow').textContent=D.tiers[p.tier].label;
  document.getElementById('i-name').textContent=p.name;
  document.getElementById('i-inst').textContent=s.label;
  document.getElementById('i-loc').textContent=s.city+', '+s.country;
  backBtn.style.display=SITEP[p.site].length>1?'block':'none';

  const chains=buildChain(id);
  let html=`<div class="areachip" style="color:${ar.color}"><span class="sw"></span>${esc(ar.label)}</div>`+
           `<p class="role">${esc(p.role)}</p>`+
           (p.note?`<p class="note">${esc(p.note)}</p>`:'');
  if(chains.length){
    html+='<div class="lk"><div class="h" style="color:#7A6A55"><i style="border-color:#7A6A55"></i>Academic ancestry</div>';
    chains.forEach(c=>{
      html+='<div class="chain">'+c.map((n,i)=>(i?'<em>\u2192</em>':'')+
        `<b data-go="${n}"${n===id?' class="me"':''}>${esc(P[n].name)}</b>`).join('')+'</div>';
    });
    html+='</div>';
  }
  const groups=[
    ['Trained by', IN[id].filter(e=>TRAIN.has(e.k)).map(e=>[e.a,e.k])],
    ['Trained', OUT[id].filter(e=>TRAIN.has(e.k)).map(e=>[e.b,e.k])],
    ['Collaborates with', D.edges.filter(e=>e.k==='collab'&&(e.a===id||e.b===id)).map(e=>[e.a===id?e.b:e.a,e.k])],
    ['Spin-outs', D.edges.filter(e=>e.k==='spinout'&&(e.a===id||e.b===id)).map(e=>[e.a===id?e.b:e.a,e.k])],
  ];
  let any=chains.length;
  for(const [title,arr] of groups){
    if(!arr.length) continue; any+=arr.length;
    const k=D.kinds[arr[0][1]];
    html+=`<div class="lk"><div class="h" style="color:${k.color}"><i style="border-color:${k.color}"></i>${title} \u00b7 ${arr.length}</div><ul>`;
    arr.forEach(([oid,kk])=>{
      const o=P[oid];
      html+=`<li data-go="${oid}"><span class="dot" style="background:${D.areas[o.area].color}"></span>`+
            `<span><span style="color:#4A4238">${esc(o.name)}</span>`+
            `<span class="sub2">${esc(D.sites[o.site].short)} \u00b7 ${esc(D.sites[o.site].country)}</span></span>`+
            `<span class="w">${esc(D.kinds[kk].label.split(' ')[0])}</span></li>`;
    });
    html+='</ul></div>';
  }
  if(!any) html+='<div class="lk"><p class="empty">No lineage link recorded for this person in the sources behind this map.</p></div>';
  ibody.innerHTML=html; wire(); info.classList.add('on');
  document.getElementById('hint').style.opacity=0;
}
function wire(){
  ibody.querySelectorAll('[data-go]').forEach(el=>{
    if(el.classList.contains('me')) return;
    el.onclick=()=>{const g=el.dataset.go, q=P[g];
      fArea.add(q.area); fCty.add(D.sites[q.site].country); bumpFilters();
      chips('areachips',D.areas,fArea,true); countryChips();
      selectPerson(g); const s=D.sites[q.site]; flyTo(s.lon,s.lat);};
  });
}

/* ================= filters ================= */
function chips(el,obj,set,sw,after){
  const box=document.getElementById(el); box.innerHTML='';
  Object.entries(obj).forEach(([k,v])=>{
    const b=document.createElement('button');
    b.className='chip'+(set.has(k)?'':' off');
    b.innerHTML=(sw?`<span class="sw" style="background:${v.color}"></span>`:'')+esc(v.label);
    b.onclick=()=>{set.has(k)?set.delete(k):set.add(k);b.classList.toggle('off');bumpFilters();
      if(selPerson&&!pVis(P[selPerson])) closePanel(); if(after)after();};
    box.appendChild(b);
  });
}
chips('areachips',D.areas,fArea,true);
function countryChips(){
  const box=document.getElementById('countrychips'); box.innerHTML='';
  D.countries.forEach(([c,n])=>{
    const b=document.createElement('button');
    b.className='chip'+(fCty.has(c)?'':' off');
    b.innerHTML=esc(c)+' <span style="color:#9C907C">'+n+'</span>';
    b.onclick=()=>{fCty.has(c)?fCty.delete(c):fCty.add(c);b.classList.toggle('off');bumpFilters();
      if(selPerson&&!pVis(P[selPerson])) closePanel();};
    box.appendChild(b);
  });
}
countryChips();
document.getElementById('ctyall').onclick=()=>{
  if(fCty.size===D.countries.length) fCty.clear();
  else D.countries.forEach(([c])=>fCty.add(c));
  bumpFilters(); countryChips();
};

const kr=document.getElementById('kindrows');
Object.entries(D.kinds).forEach(([k,v])=>{
  const dash=v.dash?`stroke-dasharray="${v.dash.join(' ')}"`:'';
  kr.innerHTML+=`<div class="r"><svg width="28" height="8"><line x1="1" y1="4" x2="27" y2="4" stroke="${v.color}" stroke-width="${v.w}" ${dash} stroke-linecap="round"/></svg>${esc(v.label)}</div>`;
});

const sIn=document.getElementById('search'), sOut=document.getElementById('results');
sIn.oninput=()=>{
  const q=sIn.value.trim().toLowerCase(); sOut.innerHTML='';
  if(q.length<2) return;
  const hits=D.people.filter(p=>{
    const s=D.sites[p.site];
    return p.name.toLowerCase().includes(q)||s.label.toLowerCase().includes(q)||
           s.country.toLowerCase().includes(q)||s.city.toLowerCase().includes(q)||
           p.role.toLowerCase().includes(q);
  }).slice(0,20);
  hits.forEach(p=>{
    const li=document.createElement('li');
    li.innerHTML=`<span class="dot" style="background:${D.areas[p.area].color}"></span>`+
      `<span>${esc(p.name)}</span><span class="rc">${esc(D.sites[p.site].country)}</span>`;
    li.onclick=()=>{
      fArea.add(p.area); fCty.add(D.sites[p.site].country); bumpFilters();
      chips('areachips',D.areas,fArea,true); countryChips();
      selectPerson(p.id); const s=D.sites[p.site]; flyTo(s.lon,s.lat);
      sIn.value=''; sOut.innerHTML='';
    };
    sOut.appendChild(li);
  });
};
document.getElementById('t-spin').onchange=e=>spin=e.target.checked;
document.getElementById('t-moon').onchange=e=>showMoon=e.target.checked;
document.getElementById('t-net').onchange=e=>showNet=e.target.checked;
document.getElementById('t-names').onchange=e=>showNames=e.target.checked;
document.getElementById('t-countries').onchange=e=>showCountries=e.target.checked;
document.getElementById('t-states').onchange=e=>showStates=e.target.checked;
document.getElementById('reset').onclick=()=>{
  closePanel(); zoom=1; lat0=26; showNet=false;
  document.getElementById('t-net').checked=false;
  Object.keys(D.areas).forEach(k=>(k==='industry'||k==='mentor')?fArea.delete(k):fArea.add(k));
  D.countries.forEach(([c])=>fCty.add(c));
  bumpFilters();
  chips('areachips',D.areas,fArea,true); countryChips();
  sIn.value=''; sOut.innerHTML='';
};
const notes=document.getElementById('notes');
function showNotes(v){ notes.classList.toggle('on',v); }
document.querySelectorAll('[data-notes]').forEach(b=>b.onclick=()=>showNotes(true));
document.getElementById('notesclose').onclick=()=>showNotes(false);
cv.addEventListener('pointerdown',()=>showNotes(false));
/* ---- minimise / maximise the filter panel ---- */
const ctl=document.getElementById('ctl');
const minBtn=document.getElementById('minbtn'), maxBtn=document.getElementById('maxbtn');
const ICON={
  minus:'<svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>',
  plus :'<svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6h7M6 2.5v7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>',
  grow :'<svg viewBox="0 0 12 12" fill="none"><path d="M6 1.6v8.8M6 1.6 3.9 3.7M6 1.6l2.1 2.1M6 10.4 3.9 8.3M6 10.4l2.1-2.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
  shrink:'<svg viewBox="0 0 12 12" fill="none"><path d="M6 2.2v3.1M6 9.8V6.7M6 5.3 4.1 3.4M6 5.3l1.9-1.9M6 6.7 4.1 8.6M6 6.7l1.9 1.9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>'
};
let panelState='normal';
function setPanel(st){
  panelState=st;
  ctl.classList.toggle('min',st==='min');
  ctl.classList.toggle('max',st==='max');
  minBtn.innerHTML = st==='min'?ICON.plus:ICON.minus;
  minBtn.title = st==='min'?'Restore':'Minimise';
  minBtn.setAttribute('aria-label',minBtn.title+' panel');
  maxBtn.innerHTML = st==='max'?ICON.shrink:ICON.grow;
  maxBtn.title = st==='max'?'Restore':'Maximise';
  maxBtn.setAttribute('aria-label',maxBtn.title+' panel');
  maxBtn.style.display = st==='min'?'none':'flex';
}
minBtn.onclick=()=>setPanel(panelState==='min'?'normal':'min');
maxBtn.onclick=()=>setPanel(panelState==='max'?'normal':'max');
setPanel('normal');

window.addEventListener('keydown',e=>{
  if(e.key!=='Escape') return;
  if(notes.classList.contains('on')) showNotes(false); else closePanel();
});

resize(); lastW=cv.clientWidth; lastH=cv.clientHeight; setRot();
requestAnimationFrame(frame);
</script>
