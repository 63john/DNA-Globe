let ca=1,sa=0,cb=1,sb=0;
function setRot(){const a=-lon0*DEG,b=lat0*DEG;ca=Math.cos(a);sa=Math.sin(a);cb=Math.cos(b);sb=Math.sin(b);}
function vec(lon,lat){const la=lat*DEG,lo=lon*DEG,cl=Math.cos(la);return [cl*Math.sin(lo),Math.sin(la),cl*Math.cos(lo)];}
function rot(v){const x1=v[0]*ca+v[2]*sa, z1=-v[0]*sa+v[2]*ca, y1=v[1];
  return [x1, y1*cb-z1*sb, y1*sb+z1*cb];}
function scr(r,rad){rad=rad||1;return [cx+R*rad*r[0], cy-R*rad*r[1]];}
function nrm(v){const m=Math.hypot(v[0],v[1],v[2]);return [v[0]/m,v[1]/m,v[2]/m];}

