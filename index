function clipRing(ring){
  const n=ring.length, pr=new Array(n);
  let any=false, all=true;
  for(let i=0;i<n;i++){pr[i]=rot(ring[i]); if(pr[i][2]>0)any=true; else all=false;}
  if(!any) return [];
  if(all) return [pr];
  const runs=[]; let cur=null;
  for(let i=0;i<n;i++){
    const p=pr[i], q=pr[(i+1)%n], pv=p[2]>0, qv=q[2]>0;
    if(pv){ if(!cur)cur=[]; cur.push(p); }
    if(pv!==qv){
      const t=p[2]/(p[2]-q[2]);
      const m=nrm([p[0]+(q[0]-p[0])*t, p[1]+(q[1]-p[1])*t, 0]);
      if(pv){ cur.push(m); runs.push(cur); cur=null; } else cur=[m];
    }
  }
  if(cur){ if(runs.length) runs[0]=cur.concat(runs[0]); else runs.push(cur); }
  return runs.map(run=>{
    const A=Math.atan2(run[run.length-1][1],run[run.length-1][0]);
    const B=Math.atan2(run[0][1],run[0][0]);
    let d=B-A; while(d>Math.PI)d-=2*Math.PI; while(d<-Math.PI)d+=2*Math.PI;
    const steps=Math.max(2,Math.round(Math.abs(d)/0.05)), arc=[];
    for(let i=1;i<steps;i++){const th=A+d*i/steps;arc.push([Math.cos(th),Math.sin(th),0]);}
    return run.concat(arc);
  });
}
function tracePath(run){
  ctx.beginPath();
  for(let i=0;i<run.length;i++){const s=scr(run[i]); i?ctx.lineTo(s[0],s[1]):ctx.moveTo(s[0],s[1]);}
  ctx.closePath();
}
function strokeVisible(ring,col,w,dash){
  const pr=ring.map(rot);
  ctx.save(); ctx.strokeStyle=col; ctx.lineWidth=w; if(dash)ctx.setLineDash(dash);
  ctx.beginPath(); let pen=false;
  for(let i=0;i<pr.length;i++){
    if(pr[i][2]>0.008){const s=scr(pr[i]); pen?ctx.lineTo(s[0],s[1]):(ctx.moveTo(s[0],s[1]),pen=true);}
    else pen=false;
  }
  ctx.stroke(); ctx.restore();
}

